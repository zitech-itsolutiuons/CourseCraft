      "static/chunks/app/api/auth/[...nextauth]/route.js"
    ],
    "/assessments/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/assessments/page.js"
    ],
    "/api/assessments/generate/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/assessments/generate/route.js"
    ],
    "/api/assessments/[id]/submit/route": [
