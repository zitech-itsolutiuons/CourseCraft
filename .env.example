MONGODB_URI=mongodb://localhost:27017/coursecraft
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=
# Only needed when self-hosting behind a proxy (Vercel sets this for you):
# AUTH_TRUST_HOST=true

# Enable a provider by setting its id + secret. Callback URLs to register:
#   {your-origin}/api/auth/callback/google
#   {your-origin}/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
